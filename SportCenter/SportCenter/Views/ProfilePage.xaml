<UserControl x:Class="SportCenter.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportCenter.Views">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Margin="24,16,24,24">

            <!-- Thông báo thành công ngắn, tự ẩn -->
            <local:NoticeBar x:Name="Notice" Margin="0,0,0,12"/>

            <!-- Đầu trang: avatar, tên, vai trò -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="72" Height="72" CornerRadius="36">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22C55E" Offset="0"/>
                                <GradientStop Color="#166534" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="AvatarText" FontSize="26" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderName" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="10,3"
                                HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBlock x:Name="HeaderRole" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 1. Thông tin cá nhân -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Thông tin cá nhân" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Email là tên đăng nhập của bạn: đổi email thì lần sau đăng nhập bằng email mới."
                               Style="{StaticResource SectionSubtitle}" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Text="Họ và tên" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FullNameBox" Style="{StaticResource InputTextBox}"
                                     VerticalContentAlignment="Center" MaxLength="100"
                                     TextChanged="Info_TextChanged" LostFocus="FullName_LostFocus"/>
                            <TextBlock x:Name="FullNameError" Style="{StaticResource FieldError}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EmailBox" Style="{StaticResource InputTextBox}"
                                     VerticalContentAlignment="Center" MaxLength="100"
                                     TextChanged="Info_TextChanged" LostFocus="Email_LostFocus"/>
                            <TextBlock x:Name="EmailError" Style="{StaticResource FieldError}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PhoneBox" Style="{StaticResource InputTextBox}"
                                     VerticalContentAlignment="Center" MaxLength="10"
                                     PreviewTextInput="Phone_PreviewTextInput"
                                     TextChanged="Info_TextChanged" LostFocus="Phone_LostFocus"/>
                            <TextBlock x:Name="PhoneError" Style="{StaticResource FieldError}"/>
                            <TextBlock x:Name="PhoneHint" Text="Không bắt buộc. 10 số, bắt đầu bằng 0."
                                       Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ProfileErrorBanner" Visibility="Collapsed" Background="{StaticResource ErrorBackgroundBrush}"
                            CornerRadius="8" Padding="12,8" Margin="0,16,0,0">
                        <TextBlock x:Name="ProfileErrorText" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <Button x:Name="SaveButton" Content="Lưu thay đổi" Width="160" HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" IsEnabled="False" Click="Save_Click"/>
                </StackPanel>
            </Border>

            <!-- 2. Đổi mật khẩu -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Đổi mật khẩu" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Mật khẩu mới tối thiểu 6 ký tự và phải khác mật khẩu hiện tại."
                               Style="{StaticResource SectionSubtitle}" TextWrapping="Wrap"/>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource InputPasswordBox}"
                                     VerticalContentAlignment="Center" MaxLength="72"
                                     PasswordChanged="Password_Changed" LostFocus="CurrentPassword_LostFocus"/>
                        <TextBlock x:Name="CurrentPasswordError" Style="{StaticResource FieldError}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mật khẩu mới" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource InputPasswordBox}"
                                         VerticalContentAlignment="Center" MaxLength="72"
                                         PasswordChanged="Password_Changed" LostFocus="NewPassword_LostFocus"/>
                            <TextBlock x:Name="NewPasswordError" Style="{StaticResource FieldError}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource InputPasswordBox}"
                                         VerticalContentAlignment="Center" MaxLength="72"
                                         PasswordChanged="Password_Changed" LostFocus="Confirm_LostFocus"/>
                            <TextBlock x:Name="ConfirmError" Style="{StaticResource FieldError}"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="PasswordErrorBanner" Visibility="Collapsed" Background="{StaticResource ErrorBackgroundBrush}"
                            CornerRadius="8" Padding="12,8" Margin="0,16,0,0">
                        <TextBlock x:Name="PasswordErrorText" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <Button x:Name="PasswordButton" Content="Đổi mật khẩu" Width="160" HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" IsEnabled="False" Click="ChangePassword_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
