<UserControl x:Class="SportCenter.Views.MemberShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SportCenter.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}">
            <DockPanel Margin="16,20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,28">
                    <views:LogoControl Width="40" Height="40"/>
                    <TextBlock Text="SportCenter" FontSize="20" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="NavMenu"/>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0">
                    <Button DockPanel.Dock="Right" Content="Đăng xuất" Style="{StaticResource LinkButton}"
                            FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                            Click="LogoutButton_Click"/>
                    <Border DockPanel.Dock="Right" Background="{StaticResource PrimaryLightBrush}" CornerRadius="12"
                            Padding="10,3" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RoleText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </Border>
                    <TextBlock x:Name="PageTitleText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Page host -->
            <ContentControl x:Name="PageHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</UserControl>
