<UserControl x:Class="SportCenter.Views.MemberClassPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Bộ lọc: môn rồi khóa -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox x:Name="SportFilter" Width="180" Margin="0,0,12,0"
                      DisplayMemberPath="SportName" SelectionChanged="SportFilter_Changed"/>
            <ComboBox x:Name="CourseFilter" Width="220"
                      DisplayMemberPath="CourseName" SelectionChanged="CourseFilter_Changed"/>
        </StackPanel>

        <DataGrid x:Name="ClassGrid" Grid.Row="1" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lớp"        Binding="{Binding ClassName}"  MinWidth="130" Width="1.6*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Môn"        Binding="{Binding SportName}"  MinWidth="90"  Width="*"    ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Khóa"       Binding="{Binding CourseName}" MinWidth="120" Width="1.4*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Level"      Binding="{Binding Level, TargetNullValue=—}" MinWidth="100" Width="*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Coach"      Binding="{Binding CoachName, TargetNullValue='Chưa phân công'}" MinWidth="120" Width="1.2*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Phòng"      Binding="{Binding RoomName}"   MinWidth="110" Width="1.2*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Khai giảng" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="105" MinWidth="105"/>
                <DataGridTextColumn Header="Giờ học"    Binding="{Binding ScheduleText}" MinWidth="160" Width="2*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Còn chỗ"    Binding="{Binding SeatsLeft}"  Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                <DataGridTextColumn Header="Học phí"    Binding="{Binding TuitionFee, StringFormat='{}{0:N0} ₫', ConverterCulture=vi-VN}" Width="120" MinWidth="120"/>
                <DataGridTemplateColumn Header="Đăng ký" Width="112" MinWidth="112">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Ghi danh" Tag="{Binding ClassId}"
                    Click="Enroll_Click"
                    Height="34" FontSize="13" Margin="4,3" Padding="10,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Height" Value="34"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Margin" Value="4,3"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeatsLeft}" Value="0">
                                                <Setter Property="Content" Value="Hết chỗ"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
