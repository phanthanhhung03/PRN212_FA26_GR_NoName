<UserControl x:Class="SportCenter.Views.MemberClassPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportCenter.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thông báo nhanh -->
        <local:NoticeBar x:Name="Notice" Grid.Row="0" Margin="0,0,0,12"/>

        <!-- Thanh tìm kiếm và bộ lọc nâng cao -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <!-- Hàng 1: Ô tìm kiếm từ khóa và Nút Làm mới -->
                <DockPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0">
                        <Button Content="Làm mới" Style="{StaticResource SecondaryButton}" Height="38" Width="85" Click="Reload_Click"/>
                    </StackPanel>

                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}" Height="38" Padding="12,0,28,0"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="🔍 Tìm kiếm nhanh theo tên lớp, môn, khóa, HLV, phòng..." FontSize="13" Foreground="#9CA3AF"
                                   VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        <Button x:Name="ClearSearchBtn" Content="✕" Style="{StaticResource LinkButton}" Foreground="{StaticResource MutedTextBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Padding="4"
                                Visibility="Collapsed" Click="ClearSearch_Click"/>
                    </Grid>
                </DockPanel>

                <!-- Hàng 2: Các bộ lọc ComboBox và Thống kê kết quả -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Lọc môn -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                        <TextBlock Text="Môn:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SportFilter" Width="150" Height="36"
                                  DisplayMemberPath="SportName" SelectionChanged="SportFilter_Changed"/>
                    </StackPanel>

                    <!-- Lọc khóa -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                        <TextBlock Text="Khóa:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CourseFilter" Width="170" Height="36"
                                  DisplayMemberPath="CourseName" SelectionChanged="CourseFilter_Changed"/>
                    </StackPanel>

                    <!-- Lọc tình trạng chỗ -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                        <TextBlock Text="Chỗ:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="AvailabilityFilter" Width="160" Height="36" SelectionChanged="AvailabilityFilter_Changed">
                            <ComboBoxItem Content="Tất cả các lớp" IsSelected="True"/>
                            <ComboBoxItem Content="Chỉ lớp còn chỗ"/>
                            <ComboBoxItem Content="Lớp đã hết chỗ"/>
                            <ComboBoxItem Content="Lớp đã đăng ký"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Nút reset bộ lọc -->
                    <Button Content="Xóa bộ lọc" Style="{StaticResource LinkButton}" FontSize="12" VerticalAlignment="Center"
                            Margin="0,0,14,6" Click="ResetFilters_Click"/>

                    <!-- Kết quả số lượng -->
                    <TextBlock x:Name="ResultCountText" Text="Đang tải..." VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="ClassGrid" Grid.Row="2" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lớp"        Binding="{Binding ClassName}"  MinWidth="130" Width="1.6*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Môn"        Binding="{Binding SportName}"  MinWidth="90"  Width="*"    ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Khóa"       Binding="{Binding CourseName}" MinWidth="120" Width="1.4*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Level"      Binding="{Binding Level, TargetNullValue=—}" MinWidth="95" Width="*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Coach"      Binding="{Binding CoachName, TargetNullValue='Chưa phân công'}" MinWidth="120" Width="1.2*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Phòng"      Binding="{Binding RoomName}"   MinWidth="110" Width="1.2*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Khai giảng" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="105" MinWidth="105"/>
                <DataGridTextColumn Header="Giờ học"    Binding="{Binding ScheduleText}" MinWidth="160" Width="2*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Còn chỗ"    Binding="{Binding SeatsLeft}"  Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                <DataGridTextColumn Header="Học phí"    Binding="{Binding TuitionFee, StringFormat='{}{0:N0} ₫', ConverterCulture=vi-VN}" Width="110" MinWidth="110"/>
                
                <!-- Cột hành động Đăng ký (UC05) -->
                <DataGridTemplateColumn Header="Thao tác" Width="130" MinWidth="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding EnrollButtonText}"
                                    IsEnabled="{Binding CanEnroll}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="32" Padding="8,2" FontSize="12"
                                    Click="EnrollButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
