<UserControl x:Class="SportCenter.Views.ClassListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button x:Name="NewClassButton" DockPanel.Dock="Right" Content="+ Mở lớp mới"
                    Style="{StaticResource PrimaryButton}" Width="140" Click="NewClassButton_Click"/>
            <ComboBox x:Name="SportFilter" Width="180" Margin="0,0,12,0"
                      DisplayMemberPath="SportName" SelectedValuePath="SportId"
                      SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="StatusFilter" Width="160" HorizontalAlignment="Left"
                      SelectionChanged="Filter_Changed"/>
        </DockPanel>

        <DataGrid x:Name="ClassGrid" Grid.Row="1" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lớp"          Binding="{Binding ClassName}"   MinWidth="130" Width="1.5*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Môn"          Binding="{Binding SportName}"   MinWidth="90" Width="*"    ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Khóa"         Binding="{Binding CourseName}"  MinWidth="150" Width="1.6*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Coach"        Binding="{Binding CoachName}"   MinWidth="130" Width="1.4*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Phòng"        Binding="{Binding RoomName}"    MinWidth="130" Width="1.4*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Khai giảng"   Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="105"/>
                <DataGridTextColumn Header="Kết thúc"     Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}"   Width="105"/>
                <DataGridTextColumn Header="Học viên"     Binding="{Binding ActiveMembers}" Width="85"  ElementStyle="{StaticResource CenterCellText}"/>
                <DataGridTextColumn Header="Sĩ số"        Binding="{Binding MaxCapacity}"   Width="75"  ElementStyle="{StaticResource CenterCellText}"/>
                <DataGridTextColumn Header="Trạng thái"   Binding="{Binding Status}"        Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
