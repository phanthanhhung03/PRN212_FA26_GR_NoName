<UserControl x:Class="SportCenter.Views.ClassListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button x:Name="NewClassButton" DockPanel.Dock="Right" Content="+ Mở lớp mới"
                    Style="{StaticResource PrimaryButton}" Width="140"/>
            <ComboBox x:Name="SportFilter" Width="180" Height="36" Margin="0,0,12,0"
                      DisplayMemberPath="SportName" SelectedValuePath="SportId"
                      SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="StatusFilter" Width="160" Height="36" HorizontalAlignment="Left"
                      SelectionChanged="Filter_Changed"/>
        </DockPanel>

        <DataGrid x:Name="ClassGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lớp"          Binding="{Binding ClassName}"/>
                <DataGridTextColumn Header="Môn"          Binding="{Binding SportName}"/>
                <DataGridTextColumn Header="Khóa"         Binding="{Binding CourseName}"/>
                <DataGridTextColumn Header="Coach"        Binding="{Binding CoachName}"/>
                <DataGridTextColumn Header="Phòng"        Binding="{Binding RoomName}"/>
                <DataGridTextColumn Header="Khai giảng"   Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="Kết thúc"     Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="Học viên"     Binding="{Binding ActiveMembers}"/>
                <DataGridTextColumn Header="Sĩ số tối đa" Binding="{Binding MaxCapacity}"/>
                <DataGridTextColumn Header="Trạng thái"   Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
