<UserControl x:Class="SportCenter.Views.LoginFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SportCenter.Views">
    <Grid Background="{StaticResource BackgroundBrush}">

        <Button Content="←  Quay lại" Style="{StaticResource LinkButton}" FontSize="14"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20,0,0"
                Click="BackButton_Click"/>

        <Border Style="{StaticResource CardStyle}" Width="400" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>

                <views:LogoControl Width="56" Height="56" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="SubtitleText" FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <!-- Inline error -->
                <Border x:Name="ErrorBanner" Visibility="Collapsed"
                        Background="{StaticResource ErrorBackgroundBrush}" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,14">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="UserEmailBox" Style="{StaticResource InputTextBox}"
                         VerticalContentAlignment="Center" TextChanged="Input_Changed"/>

                <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <Grid>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}"
                                 Padding="12,0,56,0" VerticalContentAlignment="Center"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="PasswordVisibleBox" Style="{StaticResource InputTextBox}"
                             Padding="12,0,56,0" VerticalContentAlignment="Center"
                             Visibility="Collapsed" TextChanged="PasswordVisibleBox_TextChanged"/>
                    <Button x:Name="TogglePasswordButton" Content="Hiện" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                            Click="TogglePasswordButton_Click"/>
                </Grid>

                <Grid Margin="0,14,0,20">
                    <CheckBox x:Name="RememberCheck" Content="Ghi nhớ đăng nhập" FontSize="13"
                              VerticalAlignment="Center"/>
                    <Button Content="Quên mật khẩu?" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="ForgotPassword_Click"/>
                </Grid>

                <Button x:Name="LoginButton" Content="Đăng nhập" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="LoginButton_Click"/>

                <StackPanel x:Name="RegisterPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,18,0,0" Visibility="Collapsed">
                    <TextBlock Text="Chưa có tài khoản? " FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                    <Button Content="Đăng ký ngay" Style="{StaticResource LinkButton}" FontWeight="SemiBold"
                            Click="Register_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
