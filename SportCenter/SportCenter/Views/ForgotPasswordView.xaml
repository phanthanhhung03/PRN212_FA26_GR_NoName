<UserControl x:Class="SportCenter.Views.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SportCenter.Views">
    <Grid Background="{StaticResource BackgroundBrush}">

        <Button Content="←  Quay lại" Style="{StaticResource LinkButton}" FontSize="14"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20,0,0"
                Click="BackButton_Click"/>

        <Border Style="{StaticResource CardStyle}" Width="400" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>

                <views:LogoControl Width="56" Height="56" HorizontalAlignment="Center"/>
                <TextBlock Text="Quên mật khẩu" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Nhập email và số điện thoại đã đăng ký để đặt mật khẩu mới" FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <Border x:Name="SuccessBanner" Visibility="Collapsed" Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                    <TextBlock Text="Đã đặt lại mật khẩu. Đang chuyển về đăng nhập..."
                               Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13"/>
                </Border>

                <Border x:Name="ErrorBanner" Visibility="Collapsed"
                        Background="{StaticResource ErrorBackgroundBrush}" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,14">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource InputTextBox}" VerticalContentAlignment="Center"/>

                <TextBlock Text="Số điện thoại" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <TextBox x:Name="PhoneBox" Style="{StaticResource InputTextBox}" VerticalContentAlignment="Center"/>

                <TextBlock Text="Mật khẩu mới" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource InputPasswordBox}" VerticalContentAlignment="Center"/>

                <TextBlock Text="Nhập lại mật khẩu mới" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <PasswordBox x:Name="ConfirmBox" Style="{StaticResource InputPasswordBox}" VerticalContentAlignment="Center"/>

                <Button x:Name="ResetButton" Content="Đặt lại mật khẩu" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Margin="0,24,0,0" Click="ResetButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
