<UserControl x:Class="SportCenter.Views.RoleSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SportCenter.Views">
    <UserControl.Resources>
        <!-- Role card: a button styled as a card with hover lift -->
        <Style x:Key="RoleCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Style="{StaticResource CardStyle}" Padding="20">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Lift"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                             To="-6" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Brand -->
            <views:LogoControl Width="96" Height="96" HorizontalAlignment="Center"/>
            <TextBlock Text="SportCenter" FontSize="34" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Quản lý trung tâm thể thao" FontSize="15"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <TextBlock Text="Bạn muốn đăng nhập với vai trò nào?" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,36,0,16"/>

            <!-- Role cards -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <Button x:Name="StaffButton" Style="{StaticResource RoleCardButton}" Click="StaffButton_Click">
                    <StackPanel>
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center">
                            <!-- Badge / id card icon -->
                            <Path Fill="{StaticResource PrimaryDarkBrush}" Stretch="Uniform" Width="30" Height="30"
                                  Data="M 4,4 H 28 A 3,3 0 0 1 31,7 V 25 A 3,3 0 0 1 28,28 H 4 A 3,3 0 0 1 1,25 V 7 A 3,3 0 0 1 4,4 Z
                                        M 9,10 A 3,3 0 1 0 15,10 A 3,3 0 1 0 9,10 Z
                                        M 6,21 C 6,17 18,17 18,21 V 23 H 6 Z
                                        M 21,10 H 27 V 12 H 21 Z M 21,15 H 27 V 17 H 21 Z"/>
                        </Border>
                        <TextBlock Text="Nhân viên" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Staff · Coach · Manager" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="Dành cho đội ngũ vận hành và huấn luyện của trung tâm"
                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Width="220"/>
                    </StackPanel>
                </Button>

                <Button x:Name="MemberButton" Style="{StaticResource RoleCardButton}" Click="MemberButton_Click">
                    <StackPanel>
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="#FFEDD5" HorizontalAlignment="Center">
                            <!-- Person icon -->
                            <Path Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="28" Height="28"
                                  Data="M 8,8 A 6,6 0 1 0 20,8 A 6,6 0 1 0 8,8 Z
                                        M 2,26 C 2,16 26,16 26,26 V 28 H 2 Z"/>
                        </Border>
                        <TextBlock Text="Học viên" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Member" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="Xem lớp, đăng ký học và theo dõi lịch học của bạn"
                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Width="220"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
