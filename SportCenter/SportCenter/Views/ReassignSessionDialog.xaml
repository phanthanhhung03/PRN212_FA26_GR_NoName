<Window x:Class="SportCenter.Views.ReassignSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi coach / phòng" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Mục không chọn được (bận / không đủ chỗ) bị làm xám -->
        <Style x:Key="ChoiceItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Đổi coach / phòng" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryDarkBrush}"/>
        <TextBlock x:Name="InfoText" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,18"/>

        <TextBlock Text="Coach" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CoachBox" IsEnabled="False" ItemContainerStyle="{StaticResource ChoiceItem}"
                  SelectionChanged="Choice_Changed" Margin="0,0,0,14">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding FullName, Mode=OneWay}"/>
                        <Run Text="{Binding NoteSuffix, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Phòng" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="RoomBox" IsEnabled="False" ItemContainerStyle="{StaticResource ChoiceItem}"
                  SelectionChanged="Choice_Changed">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding RoomName, Mode=OneWay}"/>
                        <Run Text="{Binding Capacity, Mode=OneWay, StringFormat=' · {0} chỗ'}"
                             Foreground="{StaticResource MutedTextBrush}"/>
                        <Run Text="{Binding NoteSuffix, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Chỉ những mục bạn chọn khác hiện tại sẽ được đổi." FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"/>

        <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{StaticResource ErrorBackgroundBrush}"
                CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Hủy bỏ" IsCancel="True" Width="100" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="SaveButton" Content="Lưu" IsDefault="True" Width="100" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
