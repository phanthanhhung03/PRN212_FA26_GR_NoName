<UserControl x:Class="SportCenter.Views.ClassDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Nhãn trạng thái buổi học -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#EEF2F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hàng buổi học: buổi hủy mờ đi, buổi sắp tới gần nhất in đậm và nền xanh nhạt -->
        <Style x:Key="SessionRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="#F0FDF4"/>
                </DataTrigger>
                <!-- Đặt sau để dòng đang chọn vẫn tô màu chọn, kể cả khi là buổi tiếp theo -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Đầu trang -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="←  Quay lại danh sách" Style="{StaticResource LinkButton}" FontSize="14"
                    HorizontalAlignment="Left" Click="Back_Click"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                <Border x:Name="StatusBadge" CornerRadius="10" Padding="10,3" Margin="14,0,0,0"
                        Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="StatusBadgeText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="13"
                       Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Thông tin lớp + tiến độ -->
        <Border x:Name="InfoCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,12,14">
                        <TextBlock Text="Môn · Level" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="SportText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,14">
                        <TextBlock Text="Coach" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="CoachText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Phòng" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="RoomText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Khai giảng → kết thúc" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="DatesText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Học viên" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="MembersText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ProgressText" Style="{StaticResource InfoLabel}"/>
                        <ProgressBar x:Name="ProgressBar" Height="10" Margin="0,6,0,0" Minimum="0" Maximum="1"
                                     Foreground="{StaticResource PrimaryBrush}" Background="#E5E7EB" BorderThickness="0"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Các buổi học -->
        <DataGrid x:Name="SessionGrid" Grid.Row="2" AutoGenerateColumns="False" RowStyle="{StaticResource SessionRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Buổi"      Binding="{Binding SessionNo}"  Width="65" MinWidth="65"  ElementStyle="{StaticResource CenterCellText}"/>
                <DataGridTextColumn Header="Ngày"      Binding="{Binding DateText}"   MinWidth="150" Width="1.3*"/>
                <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeText}"   Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="Phòng"     Binding="{Binding RoomName}"   MinWidth="130" Width="1.2*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTextColumn Header="Coach"     Binding="{Binding CoachName}"  MinWidth="130" Width="1.2*" ElementStyle="{StaticResource TrimCellText}"/>
                <DataGridTemplateColumn Header="Trạng thái" Width="110" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusPillText}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ghi chú"   Binding="{Binding NoteText}"   MinWidth="170" Width="1.4*" ElementStyle="{StaticResource TrimCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
