<Window x:Class="SportCenter.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đặt lại mật khẩu" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Đặt lại mật khẩu" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
        <TextBlock x:Name="InfoText" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,18"/>

        <TextBlock Text="Mật khẩu mới" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="PasswordBox" Style="{StaticResource InputTextBox}" MaxLength="72" TextChanged="Input_Changed"/>
        <TextBlock x:Name="PasswordError" Style="{StaticResource FieldError}"/>
        <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Gửi mật khẩu này cho người dùng; họ tự đổi lại ở Hồ sơ cá nhân."/>

        <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{StaticResource ErrorBackgroundBrush}"
                CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Hủy bỏ" IsCancel="True" Width="100" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="SaveButton" Content="Đặt lại" IsDefault="True" Width="100"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
