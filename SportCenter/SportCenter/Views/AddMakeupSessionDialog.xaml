<Window x:Class="SportCenter.Views.AddMakeupSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xếp buổi bù" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Mục không chọn được (bận / không đủ chỗ / đã qua) bị làm xám -->
        <Style x:Key="ChoiceItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Xếp buổi bù" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
        <TextBlock x:Name="InfoText" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,18"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Ngày" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DatePick" IsEnabled="False" SelectedDateChanged="Date_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Khung giờ" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="SlotBox" IsEnabled="False" DisplayMemberPath="Text"
                          ItemContainerStyle="{StaticResource ChoiceItem}" SelectionChanged="Slot_Changed"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="SlotHint" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" Margin="2,-8,0,12"/>

        <TextBlock Text="Coach" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CoachBox" IsEnabled="False" ItemContainerStyle="{StaticResource ChoiceItem}"
                  SelectionChanged="Choice_Changed" Margin="0,0,0,14">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding FullName, Mode=OneWay}"/>
                        <Run Text="{Binding NoteSuffix, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Phòng" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="RoomBox" IsEnabled="False" ItemContainerStyle="{StaticResource ChoiceItem}"
                  SelectionChanged="Choice_Changed">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding RoomName, Mode=OneWay}"/>
                        <Run Text="{Binding Capacity, Mode=OneWay, StringFormat=' · {0} chỗ'}"
                             Foreground="{StaticResource MutedTextBrush}"/>
                        <Run Text="{Binding NoteSuffix, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{StaticResource ErrorBackgroundBrush}"
                CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Hủy bỏ" IsCancel="True" Width="100" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="SaveButton" Content="Xếp buổi bù" IsDefault="True" Width="130" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
