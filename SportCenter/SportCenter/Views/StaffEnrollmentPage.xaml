<UserControl x:Class="SportCenter.Views.StaffEnrollmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportCenter.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thông báo nhanh -->
        <local:NoticeBar x:Name="Notice" Grid.Row="0" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: FORM GHI DANH HỘ (BƯỚC 1, 2, 3) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- BƯỚC 1: CHỌN HỌC VIÊN -->
                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="1. Chọn học viên" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="+ Tạo học viên mới" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" Click="NewMember_Click"/>
                            </DockPanel>

                            <!-- Ô tìm kiếm -->
                            <TextBox x:Name="MemberSearchBox" Style="{StaticResource InputTextBox}"
                                     Height="38" Padding="8,0" Margin="0,0,0,8"
                                     TextChanged="MemberSearchBox_TextChanged"/>

                            <!-- Danh sách kết quả tìm kiếm -->
                            <ListBox x:Name="MemberResultsList" MaxHeight="140" Margin="0,0,0,10"
                                     DisplayMemberPath="DisplayText" SelectedValuePath="MemberId"
                                     SelectionChanged="MemberResultsList_SelectionChanged"/>

                            <!-- Thông tin học viên đang chọn -->
                            <Border x:Name="SelectedMemberBox" Background="#F1F5F9" CornerRadius="6" Padding="10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedMemberName" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    <TextBlock x:Name="SelectedMemberContact" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 2: CHỌN LỚP HỌC -->
                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="2. Chọn lớp học" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <ComboBox x:Name="ClassSelector" Margin="0,0,0,10"
                                      DisplayMemberPath="DisplayText" SelectedValuePath="ClassId"
                                      SelectionChanged="ClassSelector_SelectionChanged"/>

                            <!-- Chi tiết lớp được chọn -->
                            <Border x:Name="SelectedClassBox" Background="#F1F5F9" CornerRadius="6" Padding="10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedClassTitle" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="SelectedClassSchedule" FontSize="12" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="SelectedClassRoomCoach" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="SelectedClassFee" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 3: XÁC NHẬN & THU HỌC PHÍ -->
                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="3. Xác nhận &amp; Thu phí" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <CheckBox x:Name="PaidAtCounterCheck" Content="Đã thu tiền mặt tại quầy (kích hoạt ngay)"
                                      IsChecked="True" FontWeight="Medium" Margin="0,0,0,16"/>

                            <Button x:Name="SubmitEnrollButton" Content="Xác nhận ghi danh"
                                    Style="{StaticResource PrimaryButton}" Height="42"
                                    Click="SubmitEnroll_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- CỘT PHẢI: LỊCH SỬ GHI DANH GẦN ĐÂY -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Lượt ghi danh gần đây" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Làm mới" Style="{StaticResource SecondaryButton}" Width="85"
                                HorizontalAlignment="Right" Click="RefreshRecent_Click"/>
                    </DockPanel>

                    <DataGrid x:Name="RecentGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding EnrolledAtText}" Width="120" MinWidth="120"/>
                            <DataGridTextColumn Header="Học viên" Binding="{Binding MemberName}" Width="1.4*" MinWidth="120" ElementStyle="{StaticResource TrimCellText}"/>
                            <DataGridTextColumn Header="SĐT" Binding="{Binding MemberPhone}" Width="100" MinWidth="100"/>
                            <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="1.3*" MinWidth="110" ElementStyle="{StaticResource TrimCellText}"/>
                            <DataGridTextColumn Header="Môn" Binding="{Binding SportName}" Width="*" MinWidth="90"/>
                            <DataGridTextColumn Header="Học phí" Binding="{Binding FeeText}" Width="105" MinWidth="105" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90" MinWidth="90" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="Người ghi danh" Binding="{Binding RegisteredByName}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource TrimCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

