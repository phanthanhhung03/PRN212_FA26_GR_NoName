<UserControl x:Class="SportCenter.Views.StaffEnrollmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="18">
            <StackPanel>
                <TextBlock Text="GHI DANH HỘ HỌC VIÊN" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                <TextBlock Text="Tìm Member theo họ tên, email hoặc số điện thoại; sau đó chọn lớp đang tuyển sinh."
                           Margin="0,5,0,12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Tìm học viên"
                            Style="{StaticResource PrimaryButton}" MinWidth="140"
                            Click="Search_Click"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}"
                             VerticalContentAlignment="Center" Margin="0,0,10,0"
                             KeyDown="SearchBox_KeyDown"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="MemberGrid" Grid.Row="1" Margin="0,12,0,16"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.4*"/>
                <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Chọn một học viên ở bảng trên, sau đó chọn lớp."
                       FontWeight="SemiBold"/>
            <TextBlock Text="Lớp đang tuyển sinh" Margin="0,10,0,0"
                       FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
        </StackPanel>

        <DataGrid x:Name="ClassGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="1.4*"/>
                <DataGridTextColumn Header="Môn" Binding="{Binding SportName}" Width="*"/>
                <DataGridTextColumn Header="Khóa" Binding="{Binding CourseName}" Width="*"/>
                <DataGridTextColumn Header="Lịch" Binding="{Binding ScheduleText}" Width="1.5*"/>
                <DataGridTextColumn Header="Còn chỗ" Binding="{Binding SeatsLeft}" Width="75"/>
                <DataGridTextColumn Header="Học phí" Binding="{Binding TuitionFee, StringFormat='{}{0:N0} ₫'}" Width="110"/>
                <DataGridTemplateColumn Header="Thao tác" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Ghi danh" Padding="8,4" Margin="3"
                                    Tag="{Binding ClassId}" Click="Enroll_Click"
                                    Style="{StaticResource PrimaryButton}" Height="34" FontSize="13"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
