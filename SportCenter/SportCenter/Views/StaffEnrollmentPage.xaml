<UserControl x:Class="SportCenter.Views.StaffEnrollmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportCenter.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thông báo nhanh ở đầu trang -->
        <local:NoticeBar x:Name="Notice" Grid.Row="0" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: FORM GHI DANH HỘ (BƯỚC 1, 2, 3) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <!-- BƯỚC 1: CHỌN HỌC VIÊN -->
                    <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="1. Chọn học viên" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="+ Tạo học viên mới" Style="{StaticResource LinkButton}" FontWeight="SemiBold"
                                        HorizontalAlignment="Right" Click="NewMember_Click"/>
                            </DockPanel>

                            <!-- Khung tìm kiếm học viên (ẩn khi đã chọn) -->
                            <StackPanel x:Name="SearchPanel">
                                <TextBlock Text="Tìm kiếm theo Tên, Số điện thoại hoặc Email:" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="MemberSearchBox" Style="{StaticResource InputTextBox}"
                                         Height="40" Padding="10,0" Margin="0,0,0,8"
                                         TextChanged="MemberSearchBox_TextChanged"/>

                                <!-- Danh sách kết quả gợi ý -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,0,8">
                                    <ListBox x:Name="MemberResultsList" MaxHeight="160" BorderThickness="0" Background="Transparent"
                                             SelectionChanged="MemberResultsList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="📞 " FontSize="11"/>
                                                            <TextBlock Text="{Binding Phone, TargetNullValue='Chưa có SĐT'}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,0"/>
                                                            <TextBlock Text="✉ " FontSize="11"/>
                                                            <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>

                            <!-- Thẻ học viên đã chọn (hiển thị đẹp và có nút đổi) -->
                            <Border x:Name="SelectedMemberBox" Background="#F0FDF4" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="14" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="✓ " FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="14"/>
                                            <TextBlock x:Name="SelectedMemberName" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SelectedMemberContact" FontSize="12.5" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="✕ Đổi học viên" Style="{StaticResource LinkButton}"
                                            Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                            Click="ChangeMember_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 2: CHỌN LỚP HỌC -->
                    <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="2. Chọn lớp học" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <ComboBox x:Name="ClassSelector" Margin="0,0,0,10"
                                      DisplayMemberPath="DisplayText" SelectedValuePath="ClassId"
                                      SelectionChanged="ClassSelector_SelectionChanged"/>

                            <!-- Chi tiết lớp được chọn -->
                            <Border x:Name="SelectedClassBox" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedClassTitle" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock x:Name="SelectedClassSchedule" FontSize="12.5" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="SelectedClassRoomCoach" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="SelectedClassFee" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 3: XÁC NHẬN & THU HỌC PHÍ -->
                    <Border Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="3. Xác nhận &amp; Thu phí" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <CheckBox x:Name="PaidAtCounterCheck" Content="Đã thu tiền mặt tại quầy (kích hoạt ngay)"
                                      IsChecked="True" FontWeight="Medium" Margin="0,0,0,16"/>

                            <Button x:Name="SubmitEnrollButton" Content="Xác nhận ghi danh"
                                    Style="{StaticResource PrimaryButton}" Height="44" FontSize="14" FontWeight="SemiBold"
                                    Click="SubmitEnroll_Click"/>

                            <!-- Thông báo lỗi trực quan ngay dưới nút bấm -->
                            <Border x:Name="InlineErrorBorder" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️ " FontSize="13"/>
                                    <TextBlock x:Name="InlineErrorText" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- CỘT PHẢI: LỊCH SỬ GHI DANH GẦN ĐÂY -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Lượt ghi danh gần đây" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Làm mới" Style="{StaticResource SecondaryButton}" Width="85"
                                HorizontalAlignment="Right" Click="RefreshRecent_Click"/>
                    </DockPanel>

                    <DataGrid x:Name="RecentGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding EnrolledAtText}" Width="120" MinWidth="120"/>
                            <DataGridTextColumn Header="Học viên" Binding="{Binding MemberName}" Width="1.4*" MinWidth="120" ElementStyle="{StaticResource TrimCellText}"/>
                            <DataGridTextColumn Header="SĐT" Binding="{Binding MemberPhone}" Width="100" MinWidth="100"/>
                            <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="1.3*" MinWidth="110" ElementStyle="{StaticResource TrimCellText}"/>
                            <DataGridTextColumn Header="Môn" Binding="{Binding SportName}" Width="*" MinWidth="90"/>
                            <DataGridTextColumn Header="Học phí" Binding="{Binding FeeText}" Width="105" MinWidth="105" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90" MinWidth="90" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="Người ghi danh" Binding="{Binding RegisteredByName}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource TrimCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
