<UserControl x:Class="SportCenter.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportCenter.Views">
    <UserControl.Resources>
        <!-- Tab dạng gạch chân -->
        <Style x:Key="ReportTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="16,10" Margin="0,0,4,0" BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Hd" ContentSource="Header" TextElement.FontSize="14" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource MutedTextBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Hd" Property="TextElement.Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="ReportGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <DataTemplate x:Key="StatCard">
            <Border Style="{StaticResource CardStyle}" Width="220" Padding="18" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <local:NoticeBar x:Name="Notice" Margin="0,0,0,12"/>
            <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{StaticResource ErrorBackgroundBrush}"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Xuất PDF" Width="120" Height="36"
                    Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="Export_Click"/>
            <TextBlock Text="Tháng" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox x:Name="MonthBox" Width="140" HorizontalAlignment="Left" DisplayMemberPath="Label"
                      SelectionChanged="MonthBox_SelectionChanged"/>
        </DockPanel>

        <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0"
                    SelectionChanged="Tabs_SelectionChanged">
            <!-- Tổng quan -->
            <TabItem Header="Tổng quan" Style="{StaticResource ReportTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <ItemsControl x:Name="OverviewCards" ItemTemplate="{StaticResource StatCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Doanh thu -->
            <TabItem Header="Doanh thu" Style="{StaticResource ReportTabItem}">
                <ScrollViewer x:Name="RevenueScroll" VerticalScrollBarVisibility="Auto" Padding="0,8,16,16">
                    <StackPanel>
                        <TextBlock x:Name="RevenueTotal" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>

                        <TextBlock Text="Theo môn" Style="{StaticResource SectionTitle}"/>
                        <DataGrid x:Name="RevenueSportGrid" Style="{StaticResource ReportGrid}" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Môn" Binding="{Binding Name}" Width="*" MinWidth="140"/>
                                <DataGridTextColumn Header="Số khoản" Binding="{Binding PaymentCount}" Width="100" MinWidth="100" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Doanh thu" Binding="{Binding Amount, StringFormat='{}{0:N0} ₫', ConverterCulture=vi-VN}" Width="160" MinWidth="160"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Theo khóa" Style="{StaticResource SectionTitle}"/>
                        <DataGrid x:Name="RevenueCourseGrid" Style="{StaticResource ReportGrid}" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Khóa" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Số khoản" Binding="{Binding PaymentCount}" Width="100" MinWidth="100" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Doanh thu" Binding="{Binding Amount, StringFormat='{}{0:N0} ₫', ConverterCulture=vi-VN}" Width="160" MinWidth="160"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="6 tháng gần nhất" Style="{StaticResource SectionTitle}"/>
                        <StackPanel x:Name="TrendPanel"/>

                        <TextBlock Text="Khoản đang chờ thanh toán" Style="{StaticResource SectionTitle}"/>
                        <DataGrid x:Name="PendingGrid" Style="{StaticResource ReportGrid}" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Học viên" Binding="{Binding MemberName}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimCellText}"/>
                                <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimCellText}"/>
                                <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat='{}{0:N0} ₫', ConverterCulture=vi-VN}" Width="140" MinWidth="140"/>
                                <DataGridTextColumn Header="Đã chờ (ngày)" Binding="{Binding DaysWaiting}" Width="120" MinWidth="120" ElementStyle="{StaticResource CenterCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="PendingEmpty" Text="Không có khoản nào đang chờ." Foreground="{StaticResource MutedTextBrush}"
                                   Margin="4,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Chuyên cần -->
            <TabItem Header="Chuyên cần" Style="{StaticResource ReportTabItem}">
                <ScrollViewer x:Name="AttendanceScroll" VerticalScrollBarVisibility="Auto" Padding="0,8,16,16">
                    <StackPanel>
                        <TextBlock x:Name="AttendanceTotal" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Chuyên cần = (Có mặt + Muộn) / (Có mặt + Muộn + Vắng); vắng có phép không tính. Chỉ tính các buổi đã hoàn thành."
                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <TextBlock Text="Theo môn" Style="{StaticResource SectionTitle}"/>
                        <DataGrid x:Name="AttSportGrid" Style="{StaticResource ReportGrid}" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Môn" Binding="{Binding Display}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimCellText}"/>
                                <DataGridTextColumn Header="Có mặt" Binding="{Binding Present}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Muộn" Binding="{Binding Late}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Vắng" Binding="{Binding Absent}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Có phép" Binding="{Binding Excused}" Width="90" MinWidth="90" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Chuyên cần" Binding="{Binding RateText}" Width="110" MinWidth="110" ElementStyle="{StaticResource CenterCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Theo coach" Style="{StaticResource SectionTitle}"/>
                        <DataGrid x:Name="AttCoachGrid" Style="{StaticResource ReportGrid}" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Coach" Binding="{Binding Display}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimCellText}"/>
                                <DataGridTextColumn Header="Có mặt" Binding="{Binding Present}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Muộn" Binding="{Binding Late}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Vắng" Binding="{Binding Absent}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Có phép" Binding="{Binding Excused}" Width="90" MinWidth="90" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Chuyên cần" Binding="{Binding RateText}" Width="110" MinWidth="110" ElementStyle="{StaticResource CenterCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="AtRiskTitle" Style="{StaticResource SectionTitle}"/>
                        <DataGrid x:Name="AtRiskGrid" Style="{StaticResource ReportGrid}" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Học viên" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimCellText}"/>
                                <DataGridTextColumn Header="Lớp" Binding="{Binding Detail}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimCellText}"/>
                                <DataGridTextColumn Header="Có mặt" Binding="{Binding Present}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Muộn" Binding="{Binding Late}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Vắng" Binding="{Binding Absent}" Width="80" MinWidth="80" ElementStyle="{StaticResource CenterCellText}"/>
                                <DataGridTextColumn Header="Chuyên cần" Binding="{Binding RateText}" Width="110" MinWidth="110" ElementStyle="{StaticResource CenterCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="AtRiskEmpty" Text="Không có học viên nào dưới ngưỡng." Foreground="{StaticResource MutedTextBrush}"
                                   Margin="4,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
