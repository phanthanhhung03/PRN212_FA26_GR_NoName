<UserControl x:Class="SportCenter.Views.CreateClassPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Nhãn nhỏ phía trên mỗi ô nhập -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Dòng chú thích nhỏ dưới ô nhập -->
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Ô khung giờ: bật thì tô xanh, bận thì xám và không bấm được -->
        <Style x:Key="SlotToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Đầu trang -->
        <StackPanel Grid.Row="0">
            <Button x:Name="BackButton" Content="←  Quay lại" Style="{StaticResource LinkButton}" FontSize="14"
                    HorizontalAlignment="Left" Click="Back_Click"/>
            <TextBlock Text="Mở lớp mới" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Nội dung -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,12">
            <StackPanel MaxWidth="940" HorizontalAlignment="Stretch" Margin="0,0,16,0">

                <!-- 1. Thông tin lớp -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1. Thông tin lớp" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Hàng 1: môn, khóa -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="Môn thể thao" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="SportBox" DisplayMemberPath="SportName" SelectedValuePath="SportId"
                                          SelectionChanged="Sport_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Khóa học" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CourseBox" IsEnabled="False" SelectionChanged="Course_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Level, Mode=OneWay}"/>
                                                <Run Text="{Binding TotalSessions, Mode=OneWay, StringFormat=' · {0} buổi'}"
                                                     Foreground="{StaticResource MutedTextBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="CourseInfoText" Style="{StaticResource FieldHint}"/>
                            </StackPanel>

                            <!-- Hàng 2: phòng, coach -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="Phòng" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="RoomBox" IsEnabled="False" SelectionChanged="Room_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding RoomName, Mode=OneWay}"/>
                                                <Run Text="{Binding Capacity, Mode=OneWay, StringFormat=' · {0} chỗ'}"
                                                     Foreground="{StaticResource MutedTextBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="RoomInfoText" Style="{StaticResource FieldHint}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Coach" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CoachBox" DisplayMemberPath="FullName" IsEnabled="False"
                                          SelectionChanged="Coach_Changed"/>
                                <TextBlock x:Name="CoachInfoText" Style="{StaticResource FieldHint}"/>
                            </StackPanel>

                            <!-- Hàng 3: tên lớp, ngày khai giảng, sĩ số -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Tên lớp" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ClassNameBox" Style="{StaticResource InputTextBox}"
                                         VerticalContentAlignment="Center" MaxLength="100"
                                         TextChanged="ClassName_TextChanged"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngày khai giảng" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="StartDatePicker" SelectedDateChanged="StartDate_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sĩ số tối đa" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CapacityBox" Style="{StaticResource InputTextBox}"
                                             VerticalContentAlignment="Center" MaxLength="3"
                                             PreviewTextInput="Capacity_PreviewTextInput"
                                             TextChanged="Capacity_TextChanged"/>
                                    <TextBlock x:Name="CapacityHint" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Khung giờ -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="2. Khung giờ học trong tuần" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="SlotHint" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,-8,0,12"
                                   Text="Chọn môn, khóa, phòng, coach và ngày khai giảng để xem khung giờ còn trống."/>
                        <Grid x:Name="SlotGrid" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- 3. Tóm tắt lịch -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="3. Tóm tắt lịch" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="PreviewText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="Chọn ít nhất một khung giờ."
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Chân trang: thông báo lỗi + nút tạo lớp -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}" Padding="0,4,0,0">
            <DockPanel>
                <Button x:Name="CreateButton" DockPanel.Dock="Right" Content="Tạo lớp" Width="150"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Create_Click"/>
                <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{StaticResource ErrorBackgroundBrush}"
                        CornerRadius="8" Padding="12,8" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
