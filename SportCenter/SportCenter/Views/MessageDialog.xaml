<Window x:Class="SportCenter.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextBrush}">
    <!-- Hộp thoại thông báo dùng chung: Pending (chờ), Lỗi, Thành công, Hỏi.
         Dùng qua MessageDialog.Show / MessageDialog.Ask, màu & icon đổi theo kind. -->
    <StackPanel Margin="28,26,28,24">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Badge" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top">
                <Path x:Name="Icon" Width="24" Height="24" Stretch="None" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="16,0,0,0" Width="340">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource MutedTextBrush}" LineHeight="21"/>
            </StackPanel>
        </StackPanel>

        <!-- Khung chi tiết (tên lớp, học phí...): chỉ hiện khi có dòng -->
        <Border x:Name="DetailCard" Visibility="Collapsed" Margin="0,18,0,0" Padding="16,12"
                Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <ItemsControl x:Name="DetailList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="110" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}" Padding="16,0"/>
            <Button x:Name="OkButton" IsDefault="True" MinWidth="130" Padding="16,0"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
