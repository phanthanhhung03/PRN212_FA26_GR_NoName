<Window x:Class="SportCenter.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
        <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="Giữ lại" IsCancel="True" IsDefault="True" Width="110" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="ConfirmButton" Width="130"
                    Style="{StaticResource DangerButton}" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
