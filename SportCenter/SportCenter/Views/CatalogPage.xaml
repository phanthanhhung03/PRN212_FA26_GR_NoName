<UserControl x:Class="SportCenter.Views.CatalogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportCenter.Views">
    <UserControl.Resources>
        <!-- Nhãn trạng thái nhỏ: xanh khi hoạt động, xám khi đã ngừng -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SportItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,10" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <local:NoticeBar x:Name="Notice" Margin="0,0,0,12"/>
            <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{StaticResource ErrorBackgroundBrush}"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Trái: danh sách môn -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Môn thể thao" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <Button x:Name="AddSportButton" Content="+ Thêm môn" HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButton}" Width="120" Height="36" Click="AddSport_Click"/>
                    </DockPanel>
                    <ListBox x:Name="SportList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource SportItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SportList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource StatusPillText}">
                                            <TextBlock.Text>
                                                <Binding Path="IsActive">
                                                    <Binding.Converter>
                                                        <local:ActiveTextConverter/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SportName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding CourseCount, Mode=OneWay}"/><Run Text=" khóa · "/><Run Text="{Binding ActiveClassCount, Mode=OneWay}"/><Run Text=" lớp đang chạy"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Phải: thông tin môn + các khóa -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <TextBlock x:Name="EmptyText" Text="Chưa có môn nào. Bấm “+ Thêm môn” để bắt đầu."
                               Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <DockPanel x:Name="DetailPanel">
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="EditSportButton" Content="Sửa môn" Style="{StaticResource SecondaryButton}"
                                        Width="100" Height="36" Margin="0,0,8,0" Click="EditSport_Click"/>
                                <Button x:Name="ToggleSportButton" Content="Ngừng môn" Style="{StaticResource DangerButton}"
                                        Width="120" Height="36" Click="ToggleSport_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SportTitle" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="SportPill" Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                                        <TextBlock x:Name="SportPillText" Style="{StaticResource StatusPillText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="SportDescription" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,20,0,10">
                            <Button x:Name="AddCourseButton" Content="+ Thêm khóa" DockPanel.Dock="Right"
                                    Style="{StaticResource PrimaryButton}" Width="120" Height="36" Click="AddCourse_Click"/>
                            <TextBlock Text="Các khóa học" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid>
                            <DataGrid x:Name="CourseGrid" AutoGenerateColumns="False" MouseDoubleClick="CourseGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Level"      Binding="{Binding Level}"       MinWidth="100" Width="*"   ElementStyle="{StaticResource TrimCellText}"/>
                                    <DataGridTextColumn Header="Tên khóa"   Binding="{Binding CourseName}"  MinWidth="140" Width="2*"  ElementStyle="{StaticResource TrimCellText}"/>
                                    <DataGridTextColumn Header="Số buổi"    Binding="{Binding TotalSessions}" Width="75" MinWidth="75" ElementStyle="{StaticResource CenterCellText}"/>
                                    <DataGridTextColumn Header="Học phí"    Binding="{Binding TuitionFee, StringFormat='{}{0:N0} ₫', ConverterCulture=vi-VN}" Width="120" MinWidth="120"/>
                                    <DataGridTextColumn Header="Số lớp"     Binding="{Binding ClassCount}"  Width="70" MinWidth="70" ElementStyle="{StaticResource CenterCellText}"/>
                                    <DataGridTemplateColumn Header="Trạng thái" Width="105" MinWidth="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusPill}">
                                                    <TextBlock Style="{StaticResource StatusPillText}">
                                                        <TextBlock.Text>
                                                            <Binding Path="IsActive">
                                                                <Binding.Converter>
                                                                    <local:ActiveTextConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="140" MinWidth="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Sửa" Style="{StaticResource LinkButton}" FontWeight="SemiBold"
                                                            Margin="0,0,14,0" Click="EditCourse_Click"/>
                                                    <Button Style="{StaticResource LinkButton}" FontWeight="SemiBold"
                                                            Click="ToggleCourse_Click">
                                                        <Button.Content>
                                                            <Binding Path="IsActive">
                                                                <Binding.Converter>
                                                                    <local:ToggleTextConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Button.Content>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="NoCourseText" Text="Môn này chưa có khóa nào."
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
