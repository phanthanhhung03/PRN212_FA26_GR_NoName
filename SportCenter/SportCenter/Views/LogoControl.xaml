<UserControl x:Class="SportCenter.Views.LogoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <!-- Badge -->
            <Ellipse Width="100" Height="100">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22C55E" Offset="0"/>
                        <GradientStop Color="#166534" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Ball -->
            <Ellipse Canvas.Left="24" Canvas.Top="24" Width="52" Height="52" Fill="White"/>
            <!-- Ball seams -->
            <Path Stroke="#166534" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 50,24 C 40,38 40,62 50,76"/>
            <Path Stroke="#166534" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 50,24 C 60,38 60,62 50,76"/>
            <Path Stroke="#166534" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 24,50 L 76,50"/>
            <!-- Motion swoosh -->
            <Path Stroke="#F97316" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 12,66 C 18,86 44,94 66,88"/>
        </Canvas>
    </Viewbox>
</UserControl>
